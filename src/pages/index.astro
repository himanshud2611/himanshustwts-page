---
export const prerender = true;

import Layout from "../layouts/Layout.astro";
import ExternalLinkIcon from "../components/ExternalLinkIcon.astro";

const title = "Himanshu";

const experience = [
    {
        role: "Research x Devrel",
        company: "smallest.ai",
        companyUrl: "https://smallest.ai",
        iconPath: "/smallest-ai.png",
        date: "Mar 2026 - Apr 2026",
        description:
            "Scaling TTS Lightning v3.1",
    },
    {
        role: "Research x Product",
        company: "Upsurge",
        companyUrl: "https://upsurge.io",
        iconPath: "/upsurge-logo.jpg",
        date: "Feb 2025 - Feb 2026",
        description:
            "Founding Team: Bluebrain, Bhindi AI, Anannas AI, Mogra. We raised $4.5M in Pre-seed.",
    },
    {
        role: "ML Engineer",
        company: "SproutsAI",
        companyUrl: "https://www.sproutsai.com",
        iconPath: "/sproutsai.webp",
        date: "Oct 2024 - Feb 2025",
        description:
            "Built end-to-end autonomous agentic AI systems for hiring automation, data enrichment, and document processing.",
    },
    {
        role: "Research Internship",
        company: "IIT Bombay Trust Lab",
        companyUrl: "https://trustlab.iitb.ac.in/",
        iconPath: "/trustlab.webp",
        date: "June 2024 - Oct 2024",
        description:
            "My first adventure to model post-training at scale! Collaborated on the research project - Domain Knowledge based Q/A for LLMs, optimizing and fine-tuning Llama models for open-ended medical question answering.",
    },
];
---

<Layout title={title}>
    <div class="space-y-16 max-w-3xl">
        {/* Hero Section */}
        <div class="space-y-6">
            <div>
                <div class="flex items-center gap-4 mb-2">
                    <img 
                        src="https://unavatar.io/twitter/himanshustwts" 
                        alt="Himanshu's profile picture" 
                        class="w-12 h-12 rounded-full"
                        onerror="this.src='https://api.dicebear.com/7.x/avataaars/svg?seed=himanshu'; this.onerror=null;"
                    />
                    <h1 class="text-4xl font-medium">himanshu</h1>
                </div>
            </div>

            <p
                class="text-lg max-w-[480px] leading-relaxed text-gruvbox-light/90 dark:text-gruvbox-dark/90"
            >
                I am Co-founder at <a href="https://physera.ai/" target="_blank" rel="noopener noreferrer" class="text-gruvbox-light-accent dark:text-gruvbox-dark-accent hover:opacity-80 transition-opacity font-medium">Physera<ExternalLinkIcon /></a>. Physera is a research and product lab building systems that (perceive + reason + decide) as humans do, under the constraints humans face. Essentially, we are working at the intersection of model efficiency and behavioural simulations while building environments that are multimodal.
                <br />
                We recently released <a href="https://physera.ai/research/animation" target="_blank" rel="noopener noreferrer" class="text-gruvbox-light-accent dark:text-gruvbox-dark-accent hover:opacity-80 transition-opacity font-medium">Animation Bench<ExternalLinkIcon /></a>.
            </p>

            <ul class="my-0 max-w-2xl list-disc space-y-3 pl-5 text-lg leading-relaxed text-gruvbox-light/90 marker:text-black dark:text-gruvbox-dark/90 dark:marker:text-gruvbox-dark">
                <li>
                    I occasionally write on AI and culture. Read my writings <a
                        href="/posts"
                        class="font-medium text-gruvbox-light-accent transition-opacity hover:opacity-80 dark:text-gruvbox-dark-accent"
                    >here<ExternalLinkIcon /></a>.
                </li>
                <li>
                    I host podcasts with interesting people in AI on <a
                        href="https://www.groundzeroai.in/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-gruvbox-light-accent transition-opacity hover:opacity-80 dark:text-gruvbox-dark-accent"
                    >Ground Zero<ExternalLinkIcon /></a>. I had privilege to host my friends in AI research like Will Brown, tokenbender, Daniel Han, Vik, Ludwig, Kalomaze and many more. I can promise you will love those convos.
                </li>
                <li>
                    I am most active on <a
                        href="https://twitter.com/himanshustwts"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-gruvbox-light-accent transition-opacity hover:opacity-80 dark:text-gruvbox-dark-accent"
                    >X<ExternalLinkIcon /></a>. Please feel free to reach out.
                </li>
                <li>
                    I am grateful to be <a
                        href="/featured"
                        class="font-medium text-gruvbox-light-accent transition-opacity hover:opacity-80 dark:text-gruvbox-dark-accent"
                    >featured<ExternalLinkIcon /></a> at some amazing places.
                </li>
            </ul>
        </div>

        {/* Past Life Accordion */}
        <div class="space-y-6">
            <button
                    id="previous-life-toggle"
                    class="flex items-center gap-1 text-left font-medium hover:opacity-80 transition-opacity cursor-pointer decoration-dotted underline"
                >
                    <span>Past Life</span>
                    <svg
                        id="previous-life-arrow"
                        class="inline-block w-3 h-3 ml-0.5 mb-0.5 transition-transform duration-200 text-gruvbox-light-accent dark:text-gruvbox-dark-accent"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                        />
                    </svg>
                </button>

            <div
                id="previous-life-content"
                    class="hidden overflow-hidden transition-all duration-300"
                >
                    <div
                        class="relative border-l border-gruvbox-light/30 dark:border-gruvbox-dark/30 ml-2 pt-4"
                    >
                        {
                            experience.map((exp, index) => (
                                <div
                                    class={`relative ml-6 ${index < experience.length - 1 ? "mb-8" : ""}`}
                                >
                                    <div class="absolute w-3 h-[1px] bg-gruvbox-light/30 dark:bg-gruvbox-dark/30 -left-6 top-[0.8rem]" />
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-4">
                                            {exp.iconPath && (
                                                <img
                                                    src={exp.iconPath}
                                                    alt={`${exp.company} logo`}
                                                    class="w-10 h-10 object-contain flex-shrink-0 rounded-lg"
                                                    loading="lazy"
                                                />
                                            )}
                                            <div class="flex flex-col justify-center">
                                                <h3 class="font-medium">
                                                    {exp.role} •{" "}
                                                    {exp.companyUrl ? (
                                                        <a
                                                            href={exp.companyUrl}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="text-gruvbox-light-accent dark:text-gruvbox-dark-accent hover:opacity-80 transition-opacity"
                                                        >
                                                            {exp.company}
                                                            <ExternalLinkIcon />
                                                        </a>
                                                    ) : (
                                                        exp.company
                                                    )}
                                                </h3>
                                                <p class="text-sm text-gruvbox-light/70 dark:text-gruvbox-dark/70">
                                                    {exp.date}
                                                </p>
                                            </div>
                                        </div>
                                        <p class="mt-3">
                                            {exp.description}
                                        </p>
                                    </div>
                                </div>
                            ))
                        }
                    </div>
                </div>

            <script>
                    const toggle = document.getElementById('previous-life-toggle');
                    const content = document.getElementById('previous-life-content');
                    const arrow = document.getElementById('previous-life-arrow');

                    toggle?.addEventListener('click', () => {
                        content?.classList.toggle('hidden');
                    });
                </script>
            </div>

        <p class="mt-10 text-lg leading-relaxed text-gruvbox-light/90 dark:text-gruvbox-dark/90">
            You can email me: <a
                href="mailto:himanshu@physera.ai"
                class="text-gruvbox-light-accent dark:text-gruvbox-dark-accent hover:opacity-80 transition-opacity font-medium"
                >himanshu@physera.ai<ExternalLinkIcon /></a
            >
        </p>

    </div>
</Layout>
